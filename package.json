{
    "name": "portfolio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "homepage": "http://raziel214.github.io/portfolio",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src eslint.config.js vite.config.js vitest.config.ts",
        "lint:fix": "eslint src eslint.config.js vite.config.js vitest.config.ts --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d build",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{html,json,md,css,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "i18next": "^23.5.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-i18next": "^13.2.2",
        "react-router-dom": "^6.16.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20.19.43",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/ui": "^2.1.9",
        "eslint": "^9.39.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "gh-pages": "^6.0.0",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "jsdom": "^25.0.1",
        "lint-staged": "^15.5.2",
        "prettier": "^3.8.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.61.0",
        "vite": "^8.0.16",
        "vitest": "^2.1.9"
    }
}
